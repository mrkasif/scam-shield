# ScamShield local configuration (copy to .env if your setup loads one).
# NEVER commit real keys. On Vercel, set these under
# Project Settings → Environment Variables instead.

# Optional URLhaus Community API key (get one free at https://auth.abuse.ch/).
# When empty/missing, the URLhaus provider reports configured:false and all
# scanning works exactly as before (local analysis only).
SCAMSHIELD_URLHAUS_AUTH_KEY=

# Optional: comma-separated CORS allow-list. Empty = same-origin only.
# SCAMSHIELD_CORS_ORIGINS=

# Optional: scan-history database path. Default: data/scamshield_history.db
# (local file). On Vercel serverless the store ignores this and uses
# in-memory SQLite instead (VERCEL=1), so history is empty after every
# cold start and is never shared between function instances.
# SCAMSHIELD_HISTORY_DB=
